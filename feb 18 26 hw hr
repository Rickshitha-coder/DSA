28. Searching - Finding Two Numbers Whose Squares Sum to a Given Value


import java.util.*;

public class Solution {

    // This function checks if there exists a number 'b'
    // such that a^2 + b^2 = c using binary search
    public static boolean binarySearch(int a, int c) {

        int left = 0;                     // smallest possible b = 0
        int right = (int) Math.sqrt(c);  // largest possible b = sqrt(c)

        while (left <= right) {

            int mid = left + (right - left) / 2;  // middle value of b

            // Calculate a^2 + mid^2
            long sum = (long) a * a + (long) mid * mid;

            // If sum equals c, we found a valid pair (a, mid)
            if (sum == c) {
                return true;
            }

            // If sum is smaller than c, increase b
            if (sum < c) {
                left = mid + 1;
            }
            // If sum is greater than c, decrease b
            else {
                right = mid - 1;
            }
        }

        // No valid b found for this value of a
        return false;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int c = sc.nextInt();   // Input value

        boolean found = false;

        // Try all possible values of 'a' from 0 to sqrt(c)
        for (int a = 0; a * a <= c; a++) {

            // For each 'a', search for 'b' using binary search
            if (binarySearch(a, c)) {
                found = true;
                break;
            }
        }

        // Print result
        if (found) {
            System.out.println("true");
        } else {
            System.out.println("false");
        }
    }
}


